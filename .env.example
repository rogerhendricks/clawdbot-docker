# Token for token authentication
# Run: openssl rand -hex 32
# The token is necessary for binding the gateway --bind lan
CLAWDBOT_GATEWAY_TOKEN=

# === INTEGRATIONS ===

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp (via WhatsApp Business API)
WHATSAPP_SESSION_PATH=/home/openclaw/.openclaw/whatsapp

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# === LLM PROVIDERS ===

# Anthropic Claude (recomended)
# Option 1: API Key (RECOMENDED) - https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Option 2: Setup Token do Claude Code CLI claude setup-token)
# NOTES: OAuth tokens for Claude Code
# ANTHROPIC_SETUP_TOKEN=

# OpenAI (alternative)
# OPENAI_API_KEY=

# OpenRouter (access to multiple models) - https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Models (opcional) - complete List of models: https://openrouter.ai/models
# OPENCLAW_DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4-5

# Local Model (Ollama)
# OLLAMA_HOST=http://host.docker.internal:11434

# === CONFIGURATIONS ===

#  Additional APT Packages (optional)
# CLAWDBOT_DOCKER_APT_PACKAGES=ffmpeg build-essential chromium

# Mounts (optional)
# OPENCLAW_EXTRA_MOUNTS=/path/host:/path/container:rw
