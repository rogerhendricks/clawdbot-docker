# Token de autenticacao do gateway (OBRIGATORIO)
# Gere com: openssl rand -hex 32
# Este token e necessario para seguranca quando o gateway usa --bind lan
CLAWDBOT_GATEWAY_TOKEN=

# === INTEGRACOES ===

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp (via WhatsApp Business API ou Baileys)
WHATSAPP_SESSION_PATH=/home/clawdbot/.clawdbot/whatsapp

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# === LLM PROVIDERS ===

# Anthropic Claude (recomendado)
# Opcao 1: API Key (RECOMENDADO) - Crie em https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Opcao 2: Setup Token do Claude Code CLI (rode: claude setup-token)
# NOTA: OAuth tokens do Claude Code foram bloqueados para uso externo em Jan/2026
# ANTHROPIC_SETUP_TOKEN=

# OpenAI (alternativo)
# OPENAI_API_KEY=

# OpenRouter (acesso a multiplos modelos) - Crie em https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Modelo padrao (opcional) - Lista completa: https://openrouter.ai/models
# CLAWDBOT_DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4-5

# Modelos locais (Ollama)
# OLLAMA_HOST=http://host.docker.internal:11434

# === CONFIGURACOES ===

# Pacotes APT adicionais (opcional)
# CLAWDBOT_DOCKER_APT_PACKAGES=ffmpeg build-essential chromium

# Montagens extras (opcional)
# CLAWDBOT_EXTRA_MOUNTS=/path/host:/path/container:rw
